# Copy to .env and fill in. .env is gitignored; never commit real values.
CHEMBL_API_BASE=https://www.ebi.ac.uk/chembl/api/data
PUBCHEM_API_BASE=https://pubchem.ncbi.nlm.nih.gov/rest/pug

# Optional experiment tracking
WANDB_API_KEY=
WANDB_PROJECT=eva71-protease-tl
WANDB_ENTITY=

# Optional HuggingFace access for gated pretrained encoders
HF_TOKEN=

# Absolute path to the private data root (kept outside version control)
EVAPRO_PRIVATE_DATA=./private/data
